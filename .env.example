# =============================================================================
# Single source of truth for docker compose AND the Laravel container.
# Copy to .env and fill in. Never commit the filled-in copy.
#
#   cp .env.example .env
#   docker compose run --rm --no-deps --entrypoint php php artisan key:generate --show
#
# Note: do NOT set COMPOSE_PROJECT_NAME here. It overrides the `name:` key in
# both compose files, which is what keeps the dev and prod stacks (and their
# volumes) separate.
#
# Secrets belong in AWS Secrets Manager / SOPS / Vault for real deployments;
# the .env file is the local-and-single-host fallback.
# =============================================================================


# Host ports nginx publishes on. They differ on purpose so both stacks can be up
# at once. nginx always serves HTTP and HTTPS.
#
# On a real deployment set HTTP_PORT=80 and HTTPS_PORT=443: Let's Encrypt
# validates HTTP-01 against port 80 of the public name, and cannot reach a
# high port unless something in front forwards it.
HTTP_PORT=80
HTTPS_PORT=443
DEV_HTTP_PORT=8443
DEV_HTTPS_PORT=8543

# --- TLS ---------------------------------------------------------------------
# The certificate strategy follows APP_URL's host. A real domain gets a Let's
# Encrypt certificate issued at runtime by the certbot service; localhost (and
# *.local / *.test) gets a self-signed one generated at container start.
#
# Where expiry warnings go. Required before a certificate can be issued.
LETSENCRYPT_EMAIL=
# Issue from the untrusted staging CA while validating a deployment. Production
# allows only 5 failed authorisations per hour, and a wrong DNS record burns
# through them quickly. Flip to false once a staging certificate is issued.
LETSENCRYPT_STAGING=false
# Leave empty for the sensible default: redirect HTTP to HTTPS on a real domain,
# serve both on localhost. Set true or false to override.
TLS_REDIRECT=
DEV_TLS_REDIRECT=false

# --- Laravel -----------------------------------------------------------------
APP_NAME="Ismail I"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Also becomes NEXT_PUBLIC_SITE_URL, which Next uses as metadataBase for
# absolute OG image URLs. nginx serves the app and the site on one origin.
APP_URL=https://example.com
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------
# SQLite on the app-data named volume, shared by php and php-worker.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/data/database.sqlite

# --- Redis: cache, sessions, queue, and sockudo fan-out ----------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# --- Broadcasting: Sockudo over the Pusher-compatible protocol ---------------
BROADCAST_CONNECTION=pusher

# Shared by Laravel (as PUSHER_*) and Sockudo (as SOCKUDO_DEFAULT_APP_*).
SOCKUDO_APP_ID=cv-site
SOCKUDO_APP_KEY=
SOCKUDO_APP_SECRET=

# --- Whose CV this is --------------------------------------------------------
# One definition each. Laravel reads these through config/profile.php; the
# compose files re-export them to the browser under the NEXT_PUBLIC_ prefix that
# Next requires for client-side inlining. That prefix is a compiler requirement,
# not a second value, so it does not belong here.
# The CV's own content is not here - that lives in /CV.
PROFILE_NAME="Ismail Ibrahim"
PROFILE_TITLE="Lead Software Engineer"
PROFILE_EMAIL=ismail.ibrahim.se2026@gmail.com
# E.164 - this is what tel: links dial.
PROFILE_PHONE=+201066664587
# The same number written out for a human to read.
PROFILE_PHONE_DISPLAY="+20 106 666 4587"
PROFILE_LINKEDIN=https://www.linkedin.com/in/ismail-i-3bb377101
PROFILE_LOCATION="Remote · EET, can shift toward EST"
# Shown in the Contact section and available to the agent. Change this when the
# answer to "are you available?" changes.
PROFILE_AVAILABILITY="Open to senior, lead & fractional CTO roles"
# Served from next/public; the file itself is copied out of /CV at build time.
PROFILE_CV_PATH=/assets/docs/Ismail-Ibrahim-CV.pdf

# --- AI provider -------------------------------------------------------------
# This file is the ONLY env file the containers read. laravel/.env is shadowed
# by the environment compose exports and is ignored under docker.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-3.8-max

# --- Next.js (NEXT_PUBLIC_* are inlined into the client bundle at build) ------
# Same-origin: the browser talks to nginx, which proxies /ws to sockudo.
NEXT_PUBLIC_SOCKUDO_PATH=/ws
NEXT_PUBLIC_API_BASE=/api

